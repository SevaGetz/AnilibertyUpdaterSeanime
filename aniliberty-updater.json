{
    "id": "aniliberty-updater",
    "name": "AniLiberty Updater",
    "version": "1.0.8",
    "manifestURI": "https://raw.githubusercontent.com/SevaGetz/AnilibertyUpdaterSeanime/main/aniliberty-updater.json",
    "language": "typescript",
    "type": "plugin",
    "description": "Автоматически отслеживает обновления торрентов на AniLiberty и уведомляет об изменениях в Seanime.",
    "author": "SevaGetz",
    "icon": "https://aniliberty.top/favicon.ico",
    "website": "https://github.com/SevaGetz/AnilibertyUpdater",
    "readme": "",
    "notes": "",
    "lang": "multi",
    "payloadURI": "https://raw.githubusercontent.com/SevaGetz/AnilibertyUpdaterSeanime/main/aniliberty-updater.ts",
    "plugin": {
        "version": "1",
        "permissions": {
            "scopes": ["settings"],
            "allow": {
                "networkAccess": {
                    "allowedDomains": ["aniliberty.top", "*.aniliberty.top", "127.0.0.1", "localhost"],
                    "reasoning": "Нужно для поиска релизов через AniLiberty API и добавления magnet-ссылок напрямую в локальный qBittorrent или Transmission."
                }
            }
        }
    }
}
